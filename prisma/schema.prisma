// Phase 1 schema: identity, sessions, email tokens, audit log.
// Later phases add games, communities, teams, events, schedules and team data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
}

model User {
  id              String     @id @default(cuid())
  /// Always stored lowercased. School email; changeable only by an Admin (baseline §3).
  email           String     @unique
  fullName        String
  /// Display form as the user typed it.
  username        String
  /// Lowercased username, used for case-insensitive uniqueness and lookup.
  usernameKey     String     @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  isAdmin         Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions    Session[]
  emailTokens EmailToken[]
  auditEvents AuditLog[]   @relation("AuditActor")

  communities        CommunityMembership[]
  managedGames       GameManagerAssignment[] @relation("ManagedBy")
  assignedManagers   GameManagerAssignment[] @relation("AssignedBy")
  teamMemberships    TeamMembership[]
  rosterRequests     RosterRequest[]         @relation("Requester")
  decidedRequests    RosterRequest[]         @relation("Decider")
  events             Event[]
  scheduleEntries    ScheduleEntry[]
  announcements      Announcement[]
  vods               Vod[]
  statSheets         StatSheet[]
  statLines          PlayerStatLine[]
  comments           Comment[]
}

model Session {
  /// SHA-256 of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  /// SHA-256 of the emailed token.
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// NFREQ12: role changes, suspensions, removals and deletions are recorded here.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ───────────── Phase 2: games, communities, teams, rosters ─────────────

enum GameStatus {
  ACTIVE
  ARCHIVED
}

enum TeamStatus {
  SHELL
  ACTIVE
  ARCHIVED
}

enum RosterRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

/// A supported title. Each Game has exactly one Game Community (its memberships).
model Game {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  status    GameStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  members         CommunityMembership[]
  managers        GameManagerAssignment[]
  teams           Team[]
  events          Event[]
  scheduleEntries ScheduleEntry[]
  announcements   Announcement[]
  statDefinitions StatDefinition[]
}

model CommunityMembership {
  userId   String
  gameId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}

/// FREQ32/52: Game Manager role scoped to one game.
model GameManagerAssignment {
  userId       String
  gameId       String
  assignedById String?
  createdAt    DateTime @default(now())

  user       User  @relation("ManagedBy", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  game       Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}

model Team {
  id            String     @id @default(cuid())
  gameId        String
  name          String
  status        TeamStatus @default(SHELL)
  /// null = unlimited (FREQ57)
  maxRosterSize Int?
  season        String?
  createdAt     DateTime   @default(now())

  game            Game             @relation(fields: [gameId], references: [id], onDelete: Restrict)
  members         TeamMembership[]
  requests        RosterRequest[]
  scheduleEntries ScheduleEntry[]
  vods            Vod[]
  statSheets      StatSheet[]
  comments        Comment[]

  @@unique([gameId, name])
}

model TeamMembership {
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

/// FREQ55: a Community Member's request to join a Team, decided by a Game Manager.
model RosterRequest {
  id          String              @id @default(cuid())
  teamId      String
  userId      String
  status      RosterRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  decidedAt   DateTime?
  decidedById String?

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User  @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("Decider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([userId, status])
}

// ───────────── Phase 3: events, schedules, announcements ─────────────

/// FREQ64 / baseline C5.
enum Visibility {
  PUBLIC  // anyone, including logged-out visitors (NFREQ8)
  MEMBERS // any logged-in user (FREQ18, FREQ19)
  TEAM    // only the entry's team, its game's managers and admins
}

enum ScheduleType {
  MATCH
  SCRIM
  PRACTICE
  OTHER
}

/// FREQ11-15, 54. gameId null = global event (Admin only).
model Event {
  id          String     @id @default(cuid())
  gameId      String?
  name        String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  visibility  Visibility @default(PUBLIC)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  game      Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([gameId, startsAt])
}

/// FREQ16-18, 60. Belongs to a game, optionally to one of its teams.
model ScheduleEntry {
  id          String       @id @default(cuid())
  gameId      String
  teamId      String?
  type        ScheduleType
  title       String
  opponent    String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  visibility  Visibility
  result      String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  vods       Vod[]
  statSheets StatSheet[]

  @@index([startsAt])
  @@index([teamId, startsAt])
  @@index([gameId, startsAt])
}

/// FREQ63. gameId null = global (Admin only).
model Announcement {
  id        String   @id @default(cuid())
  gameId    String?
  title     String
  body      String
  authorId  String?
  createdAt DateTime @default(now())

  game   Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ───────────── Phase 4: VODs, statistics, comments ─────────────

/// FREQ29, 45. v1 stores links (YouTube, Twitch, other); see baseline AD9.
model Vod {
  id              String   @id @default(cuid())
  teamId          String
  scheduleEntryId String?
  title           String
  url             String
  addedById       String?
  createdAt       DateTime @default(now())

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scheduleEntry ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  addedBy       User?          @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

enum StatLevel {
  PLAYER
  TEAM
}

enum StatKind {
  INPUT
  DERIVED
}

/// FREQ61: per-game stat fields; DERIVED ones are formulas over INPUT keys of the same level (FREQ43).
model StatDefinition {
  id        String    @id @default(cuid())
  gameId    String
  key       String
  label     String
  level     StatLevel
  kind      StatKind
  formula   String?
  /// Decimal places shown for this stat.
  precision Int       @default(0)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, key])
}

/// FREQ30: one set of stats for a team's match/scrim, with team-level values and per-player lines.
model StatSheet {
  id              String   @id @default(cuid())
  teamId          String
  scheduleEntryId String?
  title           String
  playedAt        DateTime
  /// key → number (inputs and derived)
  teamValues      Json     @default("{}")
  enteredById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scheduleEntry ScheduleEntry?   @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  enteredBy     User?            @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  lines         PlayerStatLine[]

  @@index([teamId, playedAt])
}

model PlayerStatLine {
  sheetId String
  userId  String
  /// key → number (inputs and derived)
  values  Json

  sheet StatSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sheetId, userId])
  @@index([userId])
}

enum CommentTarget {
  VOD
  STAT_SHEET
}

/// FREQ31 (GM analysis comments) and FREQ62 (player replies, one level deep).
model Comment {
  id         String        @id @default(cuid())
  teamId     String
  targetType CommentTarget
  targetId   String
  parentId   String?
  authorId   String?
  body       String
  createdAt  DateTime      @default(now())

  team    Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([targetType, targetId, createdAt])
}
