# Copy to .env and adjust.
DATABASE_URL="postgresql://esports:esports@localhost:5432/esports_hub"
# Public base URL used in emailed links.
APP_URL="http://localhost:3000"
# Comma-separated list of email domains allowed to register (FREQ1).
ALLOWED_EMAIL_DOMAINS="example.edu"
# console | file | smtp | memory
MAIL_TRANSPORT="file"
MAIL_OUTBOX_DIR=".mail-outbox"
MAIL_FROM="Esports Hub <no-reply@example.edu>"
# Required when MAIL_TRANSPORT=smtp, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=""
# Multiplies every auth rate limit (keep 1 in production).
RATE_LIMIT_SCALE="1"
# Time zone for all displayed and entered times (IANA name).
APP_TIMEZONE="America/New_York"
